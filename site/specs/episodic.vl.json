{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Distribution of country-level heavy episodic drinking prevalence by WHO region,2020. Each country contributes one observation. The boxes are not individual drinking distributions.",
  "width": "container",
  "height": 290,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 0,
  "config": {
    "background": null,
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "domain": false,
      "tickColor": "#ddd4c6",
      "gridColor": "#e5ded3",
      "gridOpacity": 0.8,
      "titlePadding": 13,
      "labelPadding": 7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "orient": "bottom",
      "padding": 10,
      "offset": 16
    },
    "title": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    },
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    }
  },
  "data": {
    "url": "data/episodic-country.json"
  },
  "params": [
    {
      "name": "hedSex",
      "value": "All"
    }
  ],
  "transform": [
    {
      "filter": "datum.sex === hedSex"
    },
    {
      "joinaggregate": [
        {
          "op": "valid",
          "field": "value",
          "as": "countries"
        },
        {
          "op": "median",
          "field": "value",
          "as": "median"
        },
        {
          "op": "q1",
          "field": "value",
          "as": "q1"
        },
        {
          "op": "q3",
          "field": "value",
          "as": "q3"
        },
        {
          "op": "min",
          "field": "value",
          "as": "minimum"
        },
        {
          "op": "max",
          "field": "value",
          "as": "maximum"
        }
      ],
      "groupby": [
        "region"
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "region",
      "type": "nominal",
      "title": null,
      "sort": [
        "Africa",
        "Americas",
        "Eastern Mediterranean",
        "Europe",
        "South-East Asia",
        "Western Pacific"
      ],
      "axis": {
        "labelLimit": 140,
        "labelFontSize": 12
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "People aged 15+ (%)",
      "scale": {
        "domain": [
          0,
          70
        ]
      },
      "axis": {
        "tickCount": 5,
        "labelExpr": "datum.label + '%'"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 17,
        "color": "#46505a",
        "box": {
          "fillOpacity": 0.2,
          "stroke": "#46505a"
        },
        "median": {
          "color": "#46505a",
          "strokeWidth": 2
        },
        "rule": {
          "strokeWidth": 1
        },
        "ticks": {
          "strokeWidth": 1
        }
      },
      "encoding": {
        "tooltip": [
          {
            "field": "region",
            "type": "nominal",
            "title": "WHO region"
          },
          {
            "field": "countries",
            "type": "quantitative",
            "title": "Countries"
          },
          {
            "field": "median",
            "type": "quantitative",
            "title": "Median (%)",
            "format": ".1f"
          },
          {
            "field": "q1",
            "type": "quantitative",
            "title": "Lower quartile (%)",
            "format": ".1f"
          },
          {
            "field": "q3",
            "type": "quantitative",
            "title": "Upper quartile (%)",
            "format": ".1f"
          },
          {
            "field": "minimum",
            "type": "quantitative",
            "title": "Minimum (%)",
            "format": ".1f"
          },
          {
            "field": "maximum",
            "type": "quantitative",
            "title": "Maximum (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.iso3 === 'AUS'"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "diamond",
        "filled": true,
        "color": "#fffaf3",
        "size": 120,
        "stroke": "#29252e",
        "strokeWidth": 2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "sex",
            "type": "nominal",
            "title": "Australia, sex"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Prevalence (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.iso3 === 'AUS'"
        }
      ],
      "mark": {
        "type": "text",
        "text": "Australia",
        "align": "left",
        "dx": 9,
        "dy": -13,
        "color": "#29252e",
        "fontSize": 12,
        "fontWeight": 600
      }
    }
  ]
}
