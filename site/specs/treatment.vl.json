{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Alcohol-principal-concern closed treatment episodes for own drug use by jurisdiction. Symbol area encodes episodes, not people or prevalence. ACT anchor offset with a leader for readability.",
  "width": "container",
  "height": 370,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 0,
  "config": {
    "background": null,
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "domain": false,
      "tickColor": "#ddd4c6",
      "gridColor": "#e5ded3",
      "gridOpacity": 0.8,
      "titlePadding": 13,
      "labelPadding": 7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "orient": "bottom",
      "padding": 10,
      "offset": 16
    },
    "title": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    },
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    }
  },
  "params": [
    {
      "name": "treatmentYear",
      "value": 2024
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia.geo.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eee8dc",
        "stroke": "#fffaf3",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.1,
            "lat": -35.35,
            "lon2": 153,
            "lat2": -35.8
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#c9c0b5",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "WA",
            "lon": 122,
            "lat": -26,
            "label_lon": 117.5,
            "label_lat": -26
          },
          {
            "state": "NT",
            "lon": 133.5,
            "lat": -19.5,
            "label_lon": 133.5,
            "label_lat": -16.2
          },
          {
            "state": "SA",
            "lon": 135.5,
            "lat": -31.5,
            "label_lon": 130.3,
            "label_lat": -32.3
          },
          {
            "state": "QLD",
            "lon": 144.8,
            "lat": -22,
            "label_lon": 149.3,
            "label_lat": -21.6
          },
          {
            "state": "NSW",
            "lon": 146.8,
            "lat": -32,
            "label_lon": 152,
            "label_lat": -30
          },
          {
            "state": "VIC",
            "lon": 144.3,
            "lat": -37.5,
            "label_lon": 140.2,
            "label_lat": -38.7
          },
          {
            "state": "TAS",
            "lon": 146.7,
            "lat": -42.1,
            "label_lon": 150.5,
            "label_lat": -42.4
          },
          {
            "state": "ACT",
            "lon": 153,
            "lat": -35.8,
            "label_lon": 156,
            "label_lat": -35.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#807c72",
        "strokeWidth": 1,
        "opacity": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "label_lon"
        },
        "latitude2": {
          "field": "label_lat"
        }
      }
    },
    {
      "data": {
        "url": "data/treatment-states.json"
      },
      "transform": [
        {
          "filter": "datum.year === treatmentYear"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "WA",
                  "lon": 122,
                  "lat": -26,
                  "label_lon": 117.5,
                  "label_lat": -26
                },
                {
                  "state": "NT",
                  "lon": 133.5,
                  "lat": -19.5,
                  "label_lon": 133.5,
                  "label_lat": -16.2
                },
                {
                  "state": "SA",
                  "lon": 135.5,
                  "lat": -31.5,
                  "label_lon": 130.3,
                  "label_lat": -32.3
                },
                {
                  "state": "QLD",
                  "lon": 144.8,
                  "lat": -22,
                  "label_lon": 149.3,
                  "label_lat": -21.6
                },
                {
                  "state": "NSW",
                  "lon": 146.8,
                  "lat": -32,
                  "label_lon": 152,
                  "label_lat": -30
                },
                {
                  "state": "VIC",
                  "lon": 144.3,
                  "lat": -37.5,
                  "label_lon": 140.2,
                  "label_lat": -38.7
                },
                {
                  "state": "TAS",
                  "lon": 146.7,
                  "lat": -42.1,
                  "label_lon": 150.5,
                  "label_lat": -42.4
                },
                {
                  "state": "ACT",
                  "lon": 153,
                  "lat": -35.8,
                  "label_lon": 156,
                  "label_lat": -35.5
                }
              ]
            },
            "key": "state",
            "fields": [
              "lon",
              "lat",
              "label_lon",
              "label_lat"
            ]
          }
        },
        {
          "calculate": "datum.state + '\\n' + format(datum.episodes,',.0f')",
          "as": "label"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#46505a",
            "opacity": 0.85,
            "stroke": "#fffaf3",
            "strokeWidth": 2
          },
          "encoding": {
            "size": {
              "field": "episodes",
              "type": "quantitative",
              "title": "Closed treatment episodes",
              "scale": {
                "domain": [
                  0,
                  30000
                ],
                "range": [
                  0,
                  1900
                ]
              },
              "legend": {
                "values": [
                  5000,
                  15000,
                  30000
                ],
                "format": ",.0f"
              }
            },
            "tooltip": [
              {
                "field": "state_name",
                "type": "nominal",
                "title": "Reporting jurisdiction"
              },
              {
                "field": "period",
                "type": "nominal",
                "title": "Financial year"
              },
              {
                "field": "episodes",
                "type": "quantitative",
                "title": "Alcohol treatment episodes",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 600,
            "lineBreak": "\n",
            "lineHeight": 16,
            "baseline": "middle",
            "dy": -8,
            "aria": false,
            "color": "#fffaf3",
            "stroke": "#fffaf3",
            "strokeWidth": 3
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 600,
            "lineBreak": "\n",
            "lineHeight": 16,
            "baseline": "middle",
            "dy": -8,
            "color": "#29252e"
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ]
}
