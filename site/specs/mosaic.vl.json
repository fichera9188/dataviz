{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "National Drug Strategy Household Survey Table4.31 joint weekly/episodic-risk distribution. Areas are proportional to published shares, normalised only for rounding. Weekly categories follow explicit source row labels rather than reversed source footnotes.",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "top": 30,
    "bottom": 0,
    "left": 0,
    "right": 0
  },
  "config": {
    "background": null,
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "domain": false,
      "tickColor": "#ddd4c6",
      "gridColor": "#e5ded3",
      "gridOpacity": 0.8,
      "titlePadding": 13,
      "labelPadding": 7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "orient": "bottom",
      "padding": 10,
      "offset": 16
    },
    "title": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    },
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    }
  },
  "data": {
    "url": "data/risk-mosaic.json"
  },
  "params": [
    {
      "name": "mosaicGender",
      "value": "Persons"
    }
  ],
  "transform": [
    {
      "filter": "datum.gender === mosaicGender"
    },
    {
      "calculate": "(datum.x0+datum.x1)/2",
      "as": "cx"
    },
    {
      "calculate": "(datum.y0+datum.y1)/2",
      "as": "cy"
    },
    {
      "calculate": "format(datum.value,'.1f') + '%'",
      "as": "percentage_label"
    },
    {
      "calculate": "datum.y1-datum.y0 < 18 ? format(datum.value,'.1f')+'%' : (datum.label === 'No alcohol' ? 'No\\nalcohol' : datum.label === 'Both thresholds' ? 'Both\\nthresholds' : datum.label === 'Weekly only' ? 'Weekly\\nonly' : datum.label) + '\\n' + format(datum.value,'.1f') + '%'",
      "as": "display"
    }
  ],
  "encoding": {
    "x": {
      "field": "x0",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": null
    },
    "y": {
      "field": "y0",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          100,
          0
        ]
      },
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#c9c0b5",
        "strokeWidth": 2
      },
      "encoding": {
        "x2": {
          "field": "x1"
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "label",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "No alcohol",
              "Neither threshold",
              "Episodic only",
              "Weekly only",
              "Both thresholds"
            ],
            "range": [
              "#fffaf3",
              "#d5d1c8",
              "#c99b35",
              "#5e6c7a",
              "#b54432"
            ]
          },
          "legend": {
            "columns": 2,
            "symbolStrokeColor": "#c9c0b5"
          }
        },
        "tooltip": [
          {
            "field": "gender",
            "type": "nominal",
            "title": "Survey population"
          },
          {
            "field": "label",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Population share (%)",
            "format": ".1f"
          },
          {
            "field": "weekly",
            "type": "nominal",
            "title": "Weekly threshold"
          },
          {
            "field": "episodic",
            "type": "nominal",
            "title": "Episodic threshold"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 16,
        "dy": {
          "expr": "(datum.y1-datum.y0) * height / 100 < 54 || (datum.x1-datum.x0) * width / 100 < 65 ? 0 : -(length(split(datum.display,'\\n'))-1)*16/2"
        },
        "limit": {
          "expr": "max(25, (datum.x1-datum.x0) * width / 100 - 12)"
        }
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative"
        },
        "y": {
          "field": "cy",
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "(datum.y1-datum.y0) * height / 100 < 54 || (datum.x1-datum.x0) * width / 100 < 65",
            "field": "percentage_label"
          },
          "field": "display"
        },
        "color": {
          "condition": {
            "test": "datum.label === 'Both thresholds' || datum.label === 'Weekly only'",
            "value": "#fffaf3"
          },
          "value": "#29252e"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "indexof(['No alcohol','Neither threshold','Weekly only'], datum.label) >= 0"
        },
        {
          "calculate": "datum.label === 'No alcohol' ? 'Abstain' : datum.label === 'Neither threshold' ? '≤10/week' : '>10/week'",
          "as": "heading"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -9,
        "fontSize": 12,
        "fontWeight": 600,
        "limit": {
          "expr": "(datum.x1-datum.x0) * width / 100 - 4"
        }
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "title": null
        },
        "y": {
          "datum": 0,
          "type": "quantitative"
        },
        "text": {
          "field": "heading"
        },
        "color": {
          "value": "#29252e"
        }
      }
    }
  ]
}
