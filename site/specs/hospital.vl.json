{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Tornado chart of National Hospital Morbidity Database hospitalisation episodes, 2023–24: males extend left and females right from zero. Signed positions mirror positive counts; labels and tooltips show actual episode counts. The 55+ band is open-ended.",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 0,
  "config": {
    "background": null,
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "domain": false,
      "tickColor": "#ddd4c6",
      "gridColor": "#e5ded3",
      "gridOpacity": 0.8,
      "titlePadding": 13,
      "labelPadding": 7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "orient": "bottom",
      "padding": 10,
      "offset": 16
    },
    "title": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    },
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    }
  },
  "data": {
    "url": "data/hospital-age-sex.json"
  },
  "transform": [
    {
      "calculate": "datum.sex === 'Male' ? -datum.count : datum.count",
      "as": "position"
    }
  ],
  "encoding": {
    "y": {
      "field": "age",
      "type": "nominal",
      "title": null,
      "sort": [
        "15–24",
        "25–34",
        "35–44",
        "45–54",
        "55+"
      ],
      "axis": {
        "grid": false
      }
    },
    "x": {
      "field": "position",
      "type": "quantitative",
      "title": "Hospitalisation episodes",
      "scale": {
        "domain": [
          -26000,
          26000
        ]
      },
      "axis": {
        "values": [
          -20000,
          -10000,
          0,
          10000,
          20000
        ],
        "labelExpr": "format(abs(datum.value),',.0f')"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 26
      },
      "encoding": {
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Male",
              "Female"
            ],
            "range": [
              "#397b76",
              "#80516b"
            ]
          },
          "legend": {
            "orient": "top",
            "title": "Male: left · Female: right"
          }
        },
        "tooltip": [
          {
            "field": "age",
            "type": "nominal",
            "title": "Age"
          },
          {
            "field": "sex",
            "type": "nominal",
            "title": "Sex"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Episodes",
            "format": ",.0f"
          },
          {
            "field": "share_within_sex",
            "type": "quantitative",
            "title": "Share within sex (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#c9c0b5",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sex === 'Male'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -5,
        "fontSize": 12,
        "color": "#29252e"
      },
      "encoding": {
        "text": {
          "field": "count",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sex === 'Female'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12,
        "color": "#29252e"
      },
      "encoding": {
        "text": {
          "field": "count",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ]
}
