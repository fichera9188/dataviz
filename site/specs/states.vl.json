{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Equal-size tile cartogram with approximate Australian state arrangement. National Drug Strategy Household Survey 2022–23 prevalence of exceeding the adult risk thresholds, people14+.",
  "width": "container",
  "height": 370,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 0,
  "config": {
    "background": null,
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "domain": false,
      "tickColor": "#ddd4c6",
      "gridColor": "#e5ded3",
      "gridOpacity": 0.8,
      "titlePadding": 13,
      "labelPadding": 7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "orient": "bottom",
      "padding": 10,
      "offset": 16
    },
    "title": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    },
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    }
  },
  "data": {
    "url": "data/state-risk.json"
  },
  "params": [
    {
      "name": "stateGender",
      "value": "Persons"
    }
  ],
  "transform": [
    {
      "filter": "datum.gender === stateGender"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "values": [
            {
              "state": "WA",
              "col": 0,
              "row": 1
            },
            {
              "state": "NT",
              "col": 1,
              "row": 0
            },
            {
              "state": "QLD",
              "col": 2,
              "row": 0
            },
            {
              "state": "SA",
              "col": 1,
              "row": 1
            },
            {
              "state": "NSW",
              "col": 2,
              "row": 1
            },
            {
              "state": "ACT",
              "col": 3,
              "row": 1
            },
            {
              "state": "VIC",
              "col": 2,
              "row": 2
            },
            {
              "state": "TAS",
              "col": 2,
              "row": 3
            }
          ]
        },
        "key": "state",
        "fields": [
          "col",
          "row"
        ]
      }
    },
    {
      "calculate": "format(datum.value,'.1f')+'%'",
      "as": "display"
    }
  ],
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "padding": 0.06
      },
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "padding": 0.06
      },
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "Risky drinking (%)",
          "scale": {
            "domain": [
              0,
              60
            ],
            "range": [
              "#fff1cc",
              "#e5be62",
              "#b78324",
              "#6e450e"
            ]
          },
          "legend": {
            "gradientLength": 160
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "gender",
            "type": "nominal",
            "title": "Population"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Risky drinking (%)",
            "format": ".1f"
          },
          {
            "field": "flag",
            "type": "nominal",
            "title": "Reliability"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "dy": -8,
        "aria": false,
        "stroke": "#fffaf3",
        "strokeWidth": 3,
        "color": "#fffaf3"
      },
      "encoding": {
        "text": {
          "field": "state"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "dy": -8,
        "color": "#29252e"
      },
      "encoding": {
        "text": {
          "field": "state"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "dy": 13,
        "aria": false,
        "stroke": "#fffaf3",
        "strokeWidth": 3,
        "color": "#fffaf3"
      },
      "encoding": {
        "text": {
          "field": "display"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "dy": 13,
        "color": "#29252e"
      },
      "encoding": {
        "text": {
          "field": "display"
        }
      }
    }
  ]
}
