{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "World Health Organization estimated litres of pure alcohol per person aged15+; three-year-average indicator. Country geometry is Natural Earth. Grey means no matched estimate.",
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 0,
  "config": {
    "background": null,
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "domain": false,
      "tickColor": "#ddd4c6",
      "gridColor": "#e5ded3",
      "gridOpacity": 0.8,
      "titlePadding": 13,
      "labelPadding": 7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "orient": "bottom",
      "padding": 10,
      "offset": 16
    },
    "title": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    },
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    }
  },
  "params": [
    {
      "name": "mapYear",
      "value": 2024
    }
  ],
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/world.geo.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e4ded2",
        "stroke": "#fffaf3",
        "strokeWidth": 0.55
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Country"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/world-consumption.json"
      },
      "transform": [
        {
          "filter": "datum.year === mapYear"
        },
        {
          "lookup": "iso3",
          "from": {
            "data": {
              "url": "data/world.geo.json",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.iso3",
            "fields": [
              "geometry",
              "properties.name"
            ]
          },
          "as": [
            "geometry",
            "name"
          ]
        },
        {
          "filter": "isValid(datum.geometry)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fffaf3",
        "strokeWidth": 0.55
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "Litres of pure alcohol per person aged 15+",
          "scale": {
            "domain": [
              0,
              15
            ],
            "range": [
              "#fff1cc",
              "#e5be62",
              "#b78324",
              "#6e450e"
            ],
            "clamp": true
          },
          "legend": {
            "gradientLength": 220,
            "values": [
              0,
              3,
              6,
              9,
              12,
              15
            ],
            "labelExpr": "datum.value >= 15 ? '15+' : datum.label"
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Estimate year"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Litres per adult",
            "format": ".1f"
          },
          {
            "field": "lower",
            "type": "quantitative",
            "title": "Lower estimate",
            "format": ".1f"
          },
          {
            "field": "upper",
            "type": "quantitative",
            "title": "Upper estimate",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/world.geo.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.iso3 === 'AUS'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#29252e",
        "strokeWidth": 1.5
      }
    }
  ]
}
