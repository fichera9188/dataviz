{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Ranked horizontal bars of Australian Burden of Disease Study 2024 alcohol-attributable healthy life years lost. All populations use the same positive count scale. The labelled residual is total minus five listed major groups; no disease allocation is invented.",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 0,
  "config": {
    "background": null,
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "domain": false,
      "tickColor": "#ddd4c6",
      "gridColor": "#e5ded3",
      "gridOpacity": 0.8,
      "titlePadding": 13,
      "labelPadding": 7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "orient": "bottom",
      "padding": 10,
      "offset": 16
    },
    "title": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    },
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "color": "#29252e"
    }
  },
  "data": {
    "url": "data/burden-treemap.json"
  },
  "params": [
    {
      "name": "burdenSex",
      "value": "All"
    }
  ],
  "transform": [
    {
      "filter": "datum.sex === burdenSex"
    },
    {
      "calculate": "datum.disease === 'Cardiovascular diseases' ? 'Cardiovascular\\ndiseases' : datum.disease === 'Not itemised in this extract' ? 'Not itemised\\n(derived residual)' : datum.disease === 'Chronic liver disease' ? 'Chronic liver\\ndisease' : datum.disease === 'Alcohol use disorder' ? 'Alcohol use\\ndisorder' : datum.disease",
      "as": "category"
    },
    {
      "calculate": "format(datum.value,',.0f') + ' · ' + format(datum.share,'.1%')",
      "as": "display"
    },
    {
      "calculate": "datum.derived ? 'Total minus the five listed groups' : 'Published disease group'",
      "as": "derivation"
    },
    {
      "calculate": "isValid(datum.attributable_percent) ? format(datum.attributable_percent,'.1f') + '%' : 'Not itemised'",
      "as": "attributionLabel"
    }
  ],
  "encoding": {
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Healthy life years lost",
      "scale": {
        "domain": [
          0,
          110000
        ]
      },
      "axis": {
        "values": [
          0,
          25000,
          50000,
          75000,
          100000
        ],
        "labelExpr": "datum.value === 0 ? '0' : format(datum.value,'.2s')"
      }
    },
    "y": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "value",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 130,
        "labelLineHeight": 15,
        "labelPadding": 8,
        "labelExpr": "split(datum.label,'\\n')"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 26,
        "cornerRadiusEnd": 2,
        "stroke": "#46505a",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.disease === 'Not itemised in this extract'",
            "value": "#a39a8b"
          },
          "value": "#46505a"
        },
        "tooltip": [
          {
            "field": "disease",
            "type": "nominal",
            "title": "Disease group"
          },
          {
            "field": "sex",
            "type": "nominal",
            "title": "Population"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Healthy life years lost",
            "format": ",.0f"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of alcohol burden",
            "format": ".1%"
          },
          {
            "field": "attributionLabel",
            "type": "nominal",
            "title": "Share of this disease due to alcohol"
          },
          {
            "field": "derivation",
            "type": "nominal",
            "title": "Value type"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "align": "left",
        "dx": 6,
        "color": "#29252e"
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "width >= 280",
            "field": "display"
          },
          "field": "value",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ]
}
