{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "NHS2022 adult guideline exceedance by age and sex. Source-specific sex categories. The all-adult aggregate is deliberately excluded from the age plot.",
  "width": "container",
  "height": 310,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 0,
  "config": {
    "background": null,
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "domain": false,
      "tickColor": "#ddd4c6",
      "gridColor": "#e5ded3",
      "gridOpacity": 0.8,
      "titlePadding": 13,
      "labelPadding": 7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 400,
      "labelColor": "#625c61",
      "titleColor": "#625c61",
      "orient": "bottom",
      "padding": 10,
      "offset": 16
    },
    "title": {
      "font": "Arial",
      "color": "#29252e"
    },
    "text": {
      "font": "Arial",
      "color": "#29252e"
    }
  },
  "data": {
    "url": "data/adult-gap.json"
  },
  "transform": [
    {
      "filter": "datum.age !== 'All adults 18+' && isValid(datum.value)"
    }
  ],
  "encoding": {
    "y": {
      "field": "age",
      "type": "nominal",
      "title": null,
      "sort": [
        "18–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65–74",
        "75+"
      ],
      "axis": {
        "grid": false
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Adults exceeding the guideline (%)",
      "scale": {
        "domain": [
          0,
          55
        ]
      },
      "axis": {
        "tickCount": 6,
        "labelExpr": "datum.label + '%'"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#c9c0b5",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "aggregate": "min",
          "field": "value",
          "type": "quantitative"
        },
        "x2": {
          "aggregate": "max",
          "field": "value"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 85
      },
      "encoding": {
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Males",
              "Females"
            ],
            "range": [
              "#397b76",
              "#80516b"
            ]
          }
        },
        "tooltip": [
          {
            "field": "age",
            "type": "nominal",
            "title": "Age"
          },
          {
            "field": "sex",
            "type": "nominal",
            "title": "Sex"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Adults exceeding guideline (%)",
            "format": ".1f"
          },
          {
            "field": "flag",
            "type": "nominal",
            "title": "Reliability"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sex === 'Males'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 10,
        "color": "#397b76"
      },
      "encoding": {
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sex === 'Females'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -9,
        "fontSize": 10,
        "color": "#80516b"
      },
      "encoding": {
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}
